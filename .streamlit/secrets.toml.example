# Copiá este archivo como .streamlit/secrets.toml (en la compu) o pegá su contenido
# en Streamlit Cloud → la app → Settings → Secrets. NUNCA subas secrets.toml a GitHub.

# Base de datos Postgres de Supabase (Project Settings → Database → Connection string → URI,
# modo "Session pooler"). Sin esto la app usa un archivo SQLite local que se borra en Streamlit Cloud.
DATABASE_URL = "postgresql://postgres.xxxxx:CONTRASEÑA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Clave de la API de Claude para leer las fotos (console.anthropic.com → API Keys).
ANTHROPIC_API_KEY = "sk-ant-..."

# Usuaria única de la app.
USUARIO = "Carmen"

# Código de un solo uso para que Carmen cree su contraseña en el primer ingreso.
# Para recuperar una contraseña olvidada: poné acá un código NUEVO y ella crea otra.
CODIGO_ACTIVACION = "cambiar-por-un-codigo-largo"
